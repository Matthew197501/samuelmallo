---
interface Props {
  title: string;
  description: string;
  issuer: string;
  category: string;
  date?: Date | string;
  featured?: boolean;
  index?: number;
}

const {
  title,
  description,
  issuer,
  category,
  date,
  featured = false,
  index = 1,
} = Astro.props;

const categoryKey = category.toLowerCase();

const categoryMark =
  categoryKey.includes("recognition")
    ? "REC"
    : categoryKey.includes("award")
      ? "AWD"
      : categoryKey.includes("competition")
        ? "WIN"
        : categoryKey.includes("certification")
          ? "CERT"
          : categoryKey.includes("national")
            ? "NC"
            : "ACH";

const categoryClass =
  categoryKey.includes("recognition")
    ? "text-red-500"
    : categoryKey.includes("award")
      ? "text-yellow-400"
      : categoryKey.includes("competition")
        ? "text-green-400"
        : categoryKey.includes("certification")
          ? "text-blue-400"
          : "text-zinc-400";

const formattedDate =
  date instanceof Date
    ? date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : date;
---

<article
  class:list={[
    "group relative h-full overflow-hidden border border-zinc-800 bg-[#090909] p-6 transition-all duration-300",
    "hover:-translate-y-1 hover:border-red-500/50 hover:shadow-[0_0_35px_rgba(220,38,38,0.08)]",
    featured && "border-red-500/20 md:p-8",
  ]}
>
  <!-- Scan line -->
  <div
    class="absolute left-0 top-0 h-px w-0 bg-red-500 transition-all duration-500 group-hover:w-full"
    aria-hidden="true"
  ></div>

  <!-- Corner -->
  <div
    class="pointer-events-none absolute right-0 top-0 h-12 w-12 border-r border-t border-red-500/20"
    aria-hidden="true"
  ></div>

  <!-- Header -->
  <div class="flex items-start justify-between gap-5">

    <div
      class="flex h-14 w-14 shrink-0 items-center justify-center border border-zinc-800 bg-black transition-colors group-hover:border-red-500/40"
      aria-hidden="true"
    >
      <span
        class:list={[
          "font-mono text-xs font-bold tracking-wider",
          categoryClass,
        ]}
      >
        {categoryMark}
      </span>
    </div>

    <div class="text-right">
      <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-zinc-600">
        ACHIEVEMENT
      </p>

      <p class="mt-1 font-mono text-xs text-zinc-700">
        {String(index).padStart(2, "0")}
      </p>
    </div>

  </div>

  <!-- Category -->
  <div class="mt-6 flex flex-wrap items-center gap-2">

    <span
      class:list={[
        "border px-3 py-1 font-mono text-[10px] uppercase tracking-widest",
        categoryKey.includes("recognition")
          ? "border-red-500/20 bg-red-500/5 text-red-500"
          : categoryKey.includes("award")
            ? "border-yellow-500/20 bg-yellow-500/5 text-yellow-400"
            : categoryKey.includes("competition")
              ? "border-green-500/20 bg-green-500/5 text-green-400"
              : "border-zinc-800 bg-zinc-950 text-zinc-500",
      ]}
    >
      {category}
    </span>

    {featured && (
      <span class="border border-red-500/20 bg-red-500/5 px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-red-500">
        FEATURED
      </span>
    )}

  </div>

  <!-- Title -->
  <h2
    class:list={[
      "mt-5 font-bold leading-tight text-white",
      featured
        ? "text-2xl md:text-3xl"
        : "text-xl",
    ]}
  >
    {title}
  </h2>

  <!-- Issuer -->
  <p class="mt-3 font-mono text-xs uppercase tracking-[0.18em] text-red-500">
    {issuer}
  </p>

  <!-- Description -->
  <p class="mt-5 leading-7 text-zinc-400">
    {description}
  </p>

  <!-- Metadata -->
  <div class="mt-7 border-t border-zinc-900 pt-5">

    <div class="flex flex-wrap items-center justify-between gap-4">

      <div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-zinc-600">
          DATE
        </p>

        <p class="mt-1 font-mono text-xs text-zinc-500">
          {formattedDate ?? "DATE_NOT_SPECIFIED"}
        </p>
      </div>

      <div class="text-right">
        <p class="font-mono text-[10px] uppercase tracking-widest text-zinc-600">
          STATUS
        </p>

        <p class="mt-1 font-mono text-xs text-green-500/70">
          VERIFIED
        </p>
      </div>

    </div>

  </div>

  <!-- Footer -->
  <div class="mt-5 flex items-center justify-between">

    <span class="font-mono text-[10px] text-zinc-700">
      ACHIEVEMENT_LOG
    </span>

    <span
      class="font-mono text-[10px] text-red-500/40 transition-colors group-hover:text-red-500"
    >
      ● ARCHIVED
    </span>

  </div>

</article>