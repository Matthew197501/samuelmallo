---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/sections/ProjectCard.astro";
const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      (b.data.publishDate?.getTime() ?? 0) -
      (a.data.publishDate?.getTime() ?? 0)
  );

const featuredProjects = projects.filter(
  (project) => project.data.title === "Athena & Alice — AI Continuity Experiment"
);

const standardProjects = projects.filter(
  (project) => project.data.title !== "Athena & Alice — AI Continuity Experiment"
);
---

<BaseLayout
  title="Projects | Samuel Mallo"
  description="Selected AI, cybersecurity, systems, and engineering projects by Samuel Mallo."
>
  <main class="min-h-screen bg-black">

    <!-- HEADER -->
    <section class="relative overflow-hidden border-b border-red-500/20 bg-black">

      <div class="absolute inset-0 cyber-grid opacity-30"></div>

      <div
        class="pointer-events-none absolute left-1/2 top-0 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-red-600/5 blur-3xl"
        aria-hidden="true"
      ></div>

      <div class="relative container mx-auto px-4 py-20 sm:px-6 md:py-28 lg:px-8">

        <div class="max-w-4xl">

          <p class="font-mono text-xs uppercase tracking-[0.3em] text-red-500">
            // PROJECT_DATABASE
          </p>

          <h1
            class="mt-5 font-mono text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl"
          >
            Systems. Research. Experiments.
          </h1>

          <p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-400">
            A collection of projects spanning artificial intelligence,
            cybersecurity, systems engineering, automation, and experimental
            human-AI interaction.
          </p>

          <div class="mt-8 flex flex-wrap gap-3 font-mono text-xs">

            <span
              class="border border-green-500/20 bg-green-500/5 px-3 py-2 text-green-400"
            >
              STATUS: ONLINE
            </span>

            <span
              class="border border-zinc-800 bg-zinc-950 px-3 py-2 text-zinc-500"
            >
              MODULES: {projects.length}
            </span>

            <span
              class="border border-zinc-800 bg-zinc-950 px-3 py-2 text-zinc-500"
            >
              ACCESS: PUBLIC
            </span>

          </div>

        </div>

      </div>
    </section>


    <!-- FEATURED -->
    {featuredProjects.length > 0 && (
      <section class="border-b border-zinc-900 bg-[#080808] py-24">

        <div class="container mx-auto px-4">

          <div class="mb-10">

            <p class="cyber-label mb-3">
              // FEATURED_SYSTEMS
            </p>

            <h2 class="font-mono text-2xl font-bold text-white md:text-3xl">
              Core projects
            </h2>

            <p class="mt-3 max-w-2xl text-zinc-500">
              Experimental and technical systems representing the core of
              Samuel's work in artificial intelligence and security.
            </p>

          </div>

          <div class="grid gap-6 md:grid-cols-2">

            {featuredProjects.map((project) => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                technologies={project.data.technologies}
                slug={project.slug}
                featured={true}
              />
            ))}

          </div>

        </div>

      </section>
    )}


    <!-- OTHER PROJECTS -->
    {standardProjects.length > 0 && (
      <section class="border-b border-zinc-900 bg-black py-24">

        <div class="container mx-auto px-4">

          <div class="mb-10">

            <p class="cyber-label mb-3">
              // OTHER_MODULES
            </p>

            <h2 class="font-mono text-2xl font-bold text-white md:text-3xl">
              Research &amp; engineering
            </h2>

          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

            {standardProjects.map((project) => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                technologies={project.data.technologies}
                slug={project.slug}
              />
            ))}

          </div>

        </div>

      </section>
    )}


    <!-- EMPTY STATE -->
    {projects.length === 0 && (
      <section class="bg-black py-24">

        <div class="container mx-auto px-4">

          <div class="mx-auto max-w-2xl border border-zinc-800 bg-[#080808] p-10 text-center">

            <p class="cyber-label mb-4">
              // DATABASE_EMPTY
            </p>

            <h2 class="font-mono text-2xl font-bold text-white">
              No projects published yet.
            </h2>

            <p class="mt-4 leading-7 text-zinc-500">
              The project database is online, but no public project modules
              have been indexed.
            </p>

            <p class="mt-6 font-mono text-xs text-green-500">
              SYSTEM_READY_
            </p>

          </div>

        </div>

      </section>
    )}


    <!-- TERMINAL FOOTER -->
    <section class="bg-[#080808] py-20">

      <div class="container mx-auto px-4">

        <div class="mx-auto max-w-3xl border border-zinc-800 bg-black p-6 font-mono text-sm">

          <p class="text-zinc-600">
            samuel@mallo:~/projects$
          </p>

          <p class="mt-3 text-zinc-400">
            <span class="text-red-500">&gt;</span>
            Project database loaded successfully.
          </p>

          <p class="mt-2 text-zinc-400">
            <span class="text-red-500">&gt;</span>
            {projects.length} module(s) indexed.
          </p>

          <p class="mt-2 text-green-400">
            <span class="text-green-500">&gt;</span>
            SYSTEM READY_
          </p>

        </div>

      </div>

    </section>

  </main>
</BaseLayout>