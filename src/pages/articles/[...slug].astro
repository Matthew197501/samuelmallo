---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { data, render } = article;
const { Content } = await render();
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={data.canonicalURL}
  type="article"
  article={{
    publishDate: data.publishDate,
    modifiedDate: data.modifiedDate,
    author: data.author,
    section: data.category,
  }}
>

  <main class="relative min-h-screen overflow-hidden bg-black text-zinc-300">

    <!-- CYBER BACKGROUND -->
    <div
      class="pointer-events-none absolute inset-0 cyber-grid opacity-20"
      aria-hidden="true"
    ></div>

    <div
      class="pointer-events-none absolute left-1/2 top-0 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-red-600/5 blur-3xl"
      aria-hidden="true"
    ></div>


    <!-- READING PROGRESS -->
    <div
      id="reading-progress"
      class="fixed left-0 top-0 z-[100] h-0.5 w-0 bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.8)]"
    ></div>


    <article class="relative container mx-auto max-w-4xl px-4 py-16 md:py-24">

      <!-- BACK -->
      <a
        href="/articles"
        class="mb-10 inline-flex items-center font-mono text-xs uppercase tracking-wider text-red-500 transition-colors hover:text-red-400"
      >
        ← Back to Article Database
      </a>


      <!-- TERMINAL HEADER -->
      <header class="relative overflow-hidden border border-zinc-800 bg-[#080808]">

        <!-- Top terminal bar -->
        <div class="flex items-center justify-between border-b border-zinc-800 px-5 py-3">

          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-red-500"></span>
            <span class="h-2 w-2 rounded-full bg-yellow-500"></span>
            <span class="h-2 w-2 rounded-full bg-green-500"></span>
          </div>

          <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-zinc-700">
            ARTICLE_DATABASE
          </span>

        </div>


        <!-- Header content -->
        <div class="p-7 md:p-10">

          <div class="flex flex-wrap items-center justify-between gap-4">

            <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-red-500">
              // {data.category}
            </span>

            <span class="font-mono text-[10px] uppercase tracking-widest text-green-500">
              STATUS: PUBLISHED
            </span>

          </div>


          <h1 class="mt-7 max-w-4xl text-4xl font-bold tracking-tight text-white md:text-5xl lg:text-6xl">
            {data.title}
          </h1>


          <p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-400">
            {data.description}
          </p>


          <!-- METADATA -->
          <div class="mt-8 grid gap-px overflow-hidden border border-zinc-800 bg-zinc-800 sm:grid-cols-3">

            <div class="bg-black p-4">

              <p class="font-mono text-[10px] uppercase tracking-widest text-zinc-700">
                AUTHOR
              </p>

              <p class="mt-2 font-mono text-sm text-zinc-300">
                {data.author}
              </p>

            </div>


            <div class="bg-black p-4">

              <p class="font-mono text-[10px] uppercase tracking-widest text-zinc-700">
                PUBLISHED
              </p>

              <p class="mt-2 font-mono text-sm text-zinc-300">
                {data.publishDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </p>

            </div>


            <div class="bg-black p-4">

              <p class="font-mono text-[10px] uppercase tracking-widest text-zinc-700">
                ACCESS
              </p>

              <p class="mt-2 font-mono text-sm text-green-400">
                PUBLIC
              </p>

            </div>

          </div>

        </div>

      </header>


      <!-- ARTICLE BODY -->
      <section class="mt-10 border border-zinc-900 bg-[#050505] p-7 md:p-10">

        <div class="prose prose-lg prose-invert max-w-none

          prose-headings:font-mono
          prose-headings:text-white
          prose-headings:tracking-tight

          prose-h2:border-l
          prose-h2:border-red-500
          prose-h2:pl-4
          prose-h2:text-2xl
          prose-h2:md:text-3xl

          prose-h3:text-red-400

          prose-p:text-zinc-400
          prose-p:leading-8

          prose-strong:text-white

          prose-a:text-red-400
          prose-a:no-underline
          hover:prose-a:text-red-300

          prose-li:text-zinc-400

          prose-blockquote:border-l-red-500
          prose-blockquote:bg-red-500/5
          prose-blockquote:px-5
          prose-blockquote:py-2
          prose-blockquote:text-zinc-400

          prose-code:text-green-400
          prose-code:before:content-none
          prose-code:after:content-none

          prose-pre:border
          prose-pre:border-zinc-800
          prose-pre:bg-black
        ">

          <Content />

        </div>

      </section>


      <!-- TERMINAL FOOTER -->
      <div class="mt-8 border border-zinc-800 bg-[#080808] p-5 font-mono text-xs">

        <p class="text-zinc-700">
          samuel@mallo:~/articles$
        </p>

        <p class="mt-3 text-zinc-500">
          <span class="text-red-500">&gt;</span>
          Article transmission complete.
        </p>

        <p class="mt-2 text-green-400">
          <span class="text-green-500">&gt;</span>
          END_OF_DOCUMENT_
        </p>

      </div>


      <!-- AUTHOR FOOTER -->
      <footer class="mt-10 border-t border-zinc-900 pt-8">

        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">

          <div>

            <p class="font-mono text-xs uppercase tracking-widest text-zinc-700">
              Published by
            </p>

            <a
              href="/about"
              class="mt-1 inline-block font-semibold text-red-500 hover:text-red-400"
            >
              Samuel Mallo
            </a>

          </div>


          <a
            href="/articles"
            class="font-mono text-xs uppercase tracking-wider text-zinc-600 transition-colors hover:text-red-400"
          >
            ← Return to articles
          </a>

        </div>

      </footer>

    </article>

  </main>


  <!-- READING PROGRESS SCRIPT -->
  <script>
    const progress = document.getElementById("reading-progress");

    const updateProgress = () => {
      if (!progress) return;

      const scrollTop = window.scrollY;
      const documentHeight =
        document.documentElement.scrollHeight - window.innerHeight;

      const percentage =
        documentHeight > 0
          ? (scrollTop / documentHeight) * 100
          : 0;

      progress.style.width = `${percentage}%`;
    };

    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
  </script>

</BaseLayout>