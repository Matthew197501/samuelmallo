---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title="Articles"
  description="Technical articles, research, and professional insights from Samuel Mallo on AI, cybersecurity, systems, and technology."
>
  <main class="py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-4xl">
      <header class="max-w-3xl mb-12">
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-3">
          Writing & insights
        </p>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Articles</h1>
        <p class="text-xl text-slate-600 dark:text-slate-400">
          Technical writing and professional insights covering artificial intelligence, cybersecurity, systems engineering, and technology.
        </p>
      </header>

      {articles.length > 0 ? (
        <div class="space-y-8">
          {articles.map((article) => (
            <article class="group border-b border-slate-200 dark:border-slate-800 pb-8 last:border-0">
              <a href={`/articles/${article.slug}`} class="block rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                <h2 class="text-2xl font-bold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  {article.data.title}
                </h2>
              </a>
              <p class="text-slate-600 dark:text-slate-400">{article.data.description}</p>
              <div class="flex flex-wrap gap-x-4 gap-y-2 mt-3 text-sm text-slate-500 dark:text-slate-400">
                <span>By {article.data.author}</span>
                <span aria-hidden="true">•</span>
                <time datetime={article.data.publishDate.toISOString()}>
                  {article.data.publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                </time>
                <span aria-hidden="true">•</span>
                <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 rounded-full">{article.data.category}</span>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 p-10 text-center">
          <h2 class="text-xl font-semibold mb-2">Articles are being prepared.</h2>
          <p class="text-slate-600 dark:text-slate-400 max-w-xl mx-auto">
            Technical articles and insights will appear here as they are published.
          </p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
