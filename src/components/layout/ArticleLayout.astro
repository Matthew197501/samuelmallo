---
import BaseLayout from "../../layouts/BaseLayout.astro";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  publishDate: Date;
  modifiedDate?: Date;
  author: string;
  category: string;
}

const { title, description, canonical, image, publishDate, modifiedDate, author, category } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  type="article"
  article={{ publishDate, modifiedDate, author, section: category }}
>
  <main class="py-16 md:py-24">
    <article class="container mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <header class="mb-12">
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">{category}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 dark:text-white md:text-5xl">{title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-400 md:text-xl">{description}</p>
        <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-500 dark:text-slate-400">
          <span>By {author}</span>
          <span aria-hidden="true">•</span>
          <time datetime={publishDate.toISOString()}>{publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
          {modifiedDate && <><span aria-hidden="true">•</span><span>Updated {modifiedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span></>}
        </div>
      </header>
      <div class="prose prose-lg max-w-none dark:prose-invert">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
