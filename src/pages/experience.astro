---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceCard from "../components/sections/ExperienceCard.astro";
import experienceData from "../data/experience.json";
---

<BaseLayout title="Professional Experience">
  <main class="min-h-screen bg-black py-20 md:py-28">
    <div class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="mb-16">
        <p class="mb-4 font-mono text-xs font-semibold uppercase tracking-[0.25em] text-red-500">
          // EXPERIENCE
        </p>

        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
          Professional Experience
        </h1>

        <p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-400">
          A comprehensive timeline of my professional journey in IT security,
          systems support, and technical services.
        </p>

        <div class="mt-8 h-px w-24 bg-red-500"></div>
      </div>

      <!-- Experience Timeline -->
      <div class="space-y-8">
        {experienceData.map((exp) => (
          <ExperienceCard
            organization={exp.organization}
            position={exp.position}
            startDate={exp.startDate}
            endDate={exp.endDate}
            responsibilities={exp.responsibilities}
            technologies={exp.technologies}
          />
        ))}
      </div>

    </div>
  </main>
</BaseLayout>