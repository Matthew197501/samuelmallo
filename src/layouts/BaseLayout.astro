---
import { SITE, NAVIGATION } from "../config";
import { generateSEO } from "../utils/seo";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import "../styles/globals.css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  article?: {
    publishDate: Date;
    modifiedDate?: Date;
    author: string;
    section?: string;
  };
}

const seo = generateSEO({
  title: Astro.props.title,
  description: Astro.props.description,
  canonical: Astro.props.canonical || Astro.url.pathname,
  image: Astro.props.image,
  type: Astro.props.type,
  article: Astro.props.article,
});

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  url: SITE.siteUrl,
  description: SITE.description,
  inLanguage: "en",
  publisher: {
    "@type": "Person",
    name: SITE.author.name,
    url: new URL("/about", SITE.siteUrl).href,
  },
};

const breadcrumbItems = Astro.url.pathname
  .split("/")
  .filter(Boolean);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: SITE.author.name,
      item: SITE.siteUrl,
    },
    ...breadcrumbItems.map((segment, index) => ({
      "@type": "ListItem",
      position: index + 2,
      name: segment
        .replace(/[-_]/g, " ")
        .replace(/\b\w/g, (char) => char.toUpperCase()),
      item: new URL(
        `/${breadcrumbItems.slice(0, index + 1).join("/")}`,
        SITE.siteUrl
      ).href,
    })),
  ],
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author.name,
  url: new URL("/about", SITE.siteUrl).href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL("/about", SITE.siteUrl).href,
  },
  jobTitle: SITE.author.jobTitle,
  description: SITE.description,
  sameAs: SITE.author.sameAs,
  knowsAbout: [
    "Artificial Intelligence",
    "AI Engineering",
    "Cybersecurity",
    "Security Research",
    "Systems Engineering",
    "Machine Learning",
    "Human-AI Interaction",
  ],
};

const articleSchema = seo.article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: seo.title,
      description: seo.description,
      author: {
        "@type": "Person",
        name: seo.article.author,
        url: new URL("/about", SITE.siteUrl).href,
      },
      publisher: {
        "@type": "Person",
        name: SITE.author.name,
      },
      datePublished: seo.article.publishDate.toISOString(),
      dateModified: (
        seo.article.modifiedDate || seo.article.publishDate
      ).toISOString(),
      ...(seo.article.section ? { articleSection: seo.article.section } : {}),
      ...(seo.image ? { image: [seo.image] } : {}),
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": Astro.url.href,
      },
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={seo.description} />
    <title>{seo.title}</title>

    {seo.canonical && <link rel="canonical" href={seo.canonical} />}

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:url" content={seo.canonical || Astro.url.href} />
    {seo.image && <meta property="og:image" content={seo.image} />}

    <meta name="robots" content="index, follow" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.image && <meta name="twitter:image" content={seo.image} />}

    {seo.article && (
      <>
        <meta property="article:published_time" content={seo.article.publishDate.toISOString()} />
        {seo.article.modifiedDate && (
          <meta property="article:modified_time" content={seo.article.modifiedDate.toISOString()} />
        )}
        <meta property="article:author" content={seo.article.author} />
        {seo.article.section && (
          <meta property="article:section" content={seo.article.section} />
        )}
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
   <script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbSchema)}
/>
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
  </head>
<body class="min-h-screen antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-slate-950 focus:shadow-lg dark:focus:bg-slate-900 dark:focus:text-white">Skip to content</a>
    <Header navigation={NAVIGATION} />
    <div id="main-content">
      <slot />
    </div>
    <Footer />
  </body>
</html>
