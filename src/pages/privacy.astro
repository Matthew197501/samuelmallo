---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy">
  <main class="py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold mb-8">Privacy</h1>

      <div class="prose prose-lg dark:prose-invert max-w-none">
        <p>
          This page describes how this website handles information. A complete
          privacy policy will be published before any feature that collects
          personal information is enabled.
        </p>
        <p>
          This website is currently designed as a public professional portfolio
          and does not intentionally expose private contact information.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
