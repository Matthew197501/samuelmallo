---
interface Props {
  name: string;
  issuer: string;
  date: string;
  credentialId?: string;
  verificationUrl?: string;
  index?: number;
}

const {
  name,
  issuer,
  date,
  credentialId,
  verificationUrl,
  index,
} = Astro.props;

const hasCredentialId =
  credentialId && !credentialId.startsWith("[PLACEHOLDER");

const hasVerificationUrl =
  verificationUrl && !verificationUrl.startsWith("[PLACEHOLDER");

const issuerKey = issuer.toLowerCase();

const issuerLabel =
  issuerKey.includes("ibm")
    ? "IBM"
    : issuerKey.includes("fortinet")
      ? "FORTINET"
      : issuerKey.includes("tesda")
        ? "TESDA"
        : issuer;
---

<article
  class="group relative h-full overflow-hidden border border-zinc-800 bg-[#090909] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-red-500/50 hover:shadow-[0_0_35px_rgba(220,38,38,0.08)] md:p-7"
>
  <div
    class="absolute left-0 top-0 h-px w-0 bg-red-500 transition-all duration-500 group-hover:w-full"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute right-0 top-0 h-10 w-10 border-r border-t border-red-500/20"
    aria-hidden="true"
  ></div>

  <div class="flex items-start justify-between gap-5">

    <div
      class="flex h-14 w-14 shrink-0 items-center justify-center border border-zinc-800 bg-black transition-colors group-hover:border-red-500/40"
      aria-label={`${issuerLabel} logo`}
    >
      {issuerKey.includes("ibm") ? (
        <span class="font-mono text-lg font-bold tracking-tight text-white">
          IBM
        </span>
      ) : issuerKey.includes("fortinet") ? (
        <span class="font-mono text-[10px] font-bold tracking-wider text-white">
          FORTINET
        </span>
      ) : issuerKey.includes("tesda") ? (
        <span class="font-mono text-sm font-bold text-white">
          TESDA
        </span>
      ) : (
        <span class="font-mono text-sm font-bold text-red-500">
          {issuerLabel.slice(0, 3).toUpperCase()}
        </span>
      )}
    </div>

    <div class="flex items-center gap-3">
      {index !== undefined && (
        <span class="font-mono text-[10px] text-zinc-700">
          {String(index).padStart(2, "0")}
        </span>
      )}

      <span class="cyber-label">
        CERTIFICATION
      </span>
    </div>

  </div>

  <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-red-500">
    {issuer}
  </p>

  <h3 class="mt-3 text-lg font-bold leading-7 text-white">
    {name}
  </h3>

  <div class="mt-5 flex items-center gap-2 text-sm">
    <span class="font-medium text-zinc-300">
      Issued
    </span>

    <span class="text-zinc-700">
      //
    </span>

    <time class="font-mono text-zinc-500">
      {date}
    </time>
  </div>

  {hasCredentialId && (
    <div class="mt-5 border-t border-zinc-900 pt-4">
      <p class="font-mono text-[10px] uppercase tracking-widest text-zinc-600">
        Credential ID
      </p>

      <p class="mt-2 break-all font-mono text-xs text-zinc-500">
        {credentialId}
      </p>
    </div>
  )}

  {hasVerificationUrl && (
    <div class="mt-6">
      <a
        href={verificationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-red-500/30 bg-red-500/5 px-4 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-red-500 transition-all hover:border-red-500 hover:bg-red-500/10 hover:text-red-400"
      >
        Verify Credential
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  )}

  <div
    class="mt-6 flex items-center justify-between border-t border-zinc-900 pt-4"
  >
    <span class="font-mono text-[10px] text-zinc-700">
      CREDENTIAL_VERIFIED
    </span>

    <span class="font-mono text-[10px] text-green-500/60">
      ● ACTIVE
    </span>
  </div>

</article>