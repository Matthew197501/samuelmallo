---
interface Props {
  category: string;
  skills: string[];
}

const { category, skills } = Astro.props;
---

<article class="cyber-card h-full p-6">
  <div class="mb-5 flex items-center gap-3">
    <span
      class="h-2 w-2 rounded-full bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.8)]"
      aria-hidden="true"
    ></span>

    <h3 class="text-lg font-bold text-white">
      {category}
    </h3>
  </div>

  <ul class="space-y-3">
    {skills.map((skill) => (
      <li class="flex items-start gap-3 text-sm leading-6 text-zinc-400">
        <span
          class="mt-2 h-1 w-1 shrink-0 rounded-full bg-red-500"
          aria-hidden="true"
        ></span>

        <span>{skill}</span>
      </li>
    ))}
  </ul>
</article>  