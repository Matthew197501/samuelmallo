---
import { SITE } from "../../config";
import Button from "../ui/Button.astro";
---

<section
  class="relative overflow-hidden border-b border-green-500/20 bg-black"
  aria-labelledby="hero-title"
>
  <!-- Cyber grid -->
  <div class="absolute inset-0 cyber-grid opacity-40"></div>

  <!-- Green atmospheric glow -->
  <div
    class="absolute left-1/2 top-0 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-green-500/5 blur-3xl"
    aria-hidden="true"
  ></div>

  <!-- Decorative terminal brackets -->
  <div class="absolute left-6 top-10 hidden text-green-500/70 lg:block">
    <div class="text-2xl">┌</div>
    <div class="mt-64 text-2xl">└</div>
  </div>

  <div class="absolute right-6 top-10 hidden text-green-500/70 lg:block">
    <div class="text-2xl text-right">┐</div>
    <div class="mt-64 text-right">┘</div>
  </div>

  <div class="relative container mx-auto px-4 py-24 sm:px-6 md:py-32 lg:px-8 lg:py-40">
    <div class="mx-auto max-w-5xl text-center">

      <!-- System status -->
      <div class="mb-8 flex items-center justify-center gap-3 font-mono text-xs uppercase tracking-[0.25em] text-green-400">
        <span class="h-2 w-2 animate-pulse rounded-full bg-green-400 shadow-[0_0_10px_rgba(74,222,128,0.8)]"></span>
        SYSTEM ONLINE
      </div>

      <!-- Terminal identity -->
      <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.3em] text-green-500">
        [ AI ENGINEERING · CYBERSECURITY ]
      </p>

      <!-- Name -->
      <h1
        id="hero-title"
        class="font-mono text-5xl font-bold tracking-tight text-white sm:text-6xl md:text-7xl lg:text-8xl"
      >
        {SITE.author.name}
      </h1>

      <!-- Role -->
      <p class="mt-6 font-mono text-xl font-semibold text-green-400 sm:text-2xl">
        AI Engineer <span class="text-white/40">·</span> Cybersecurity Analyst
      </p>

      <!-- Description -->
      <p class="mx-auto mt-7 max-w-3xl text-base leading-7 text-zinc-400 sm:text-lg">
        Technology professional focused on artificial intelligence,
        cybersecurity, systems, and practical technical problem-solving.
      </p>

      <!-- Terminal data -->
      <div class="mx-auto mt-8 max-w-xl border border-green-500/20 bg-green-500/[0.02] p-4 text-left font-mono text-xs text-zinc-500">
        <p>
          <span class="text-green-500">&gt;</span>
          STATUS:
          <span class="text-green-400">OPERATIONAL</span>
        </p>

        <p class="mt-2">
          <span class="text-green-500">&gt;</span>
          SPECIALIZATION:
          <span class="text-zinc-300">AI / SECURITY / SYSTEMS</span>
        </p>

        <p class="mt-2">
          <span class="text-green-500">&gt;</span>
          BUILD:
          <span class="text-green-400">SAMUEL-MALLO.DEV</span>
        </p>
      </div>

      <!-- Actions -->
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <Button
          href="/projects"
          size="lg"
          class="!border-green-500 !bg-green-500 !text-black hover:!bg-green-400 hover:!text-black !shadow-[0_0_25px_rgba(34,197,94,0.15)]"
        >
          &gt; Explore Projects
        </Button>

        <Button
          href="/about"
          variant="outline"
          size="lg"
          class="!border-green-500/50 !text-green-400 hover:!border-green-400 hover:!bg-green-500/10 hover:!text-green-300"
        >
          &gt; About Samuel
        </Button>
      </div>

      <!-- Scroll indicator -->
      <div class="mt-14 font-mono text-xs text-green-500/60">
        <span class="animate-pulse">▼</span>
      </div>
    </div>
  </div>
</section>