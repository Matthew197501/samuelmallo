---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Samuel Mallo"
  description="Contact Samuel Mallo for professional inquiries, technical collaboration, AI, cybersecurity, and technology discussions."
>
  <main class="min-h-screen bg-black">

    <!-- HEADER -->
    <section class="relative overflow-hidden border-b border-red-500/20 bg-black">

      <div class="absolute inset-0 cyber-grid opacity-30"></div>

      <div
        class="pointer-events-none absolute left-1/2 top-0 h-[450px] w-[700px] -translate-x-1/2 rounded-full bg-red-600/5 blur-3xl"
      ></div>

      <div class="relative container mx-auto px-4 py-20 sm:px-6 md:py-28 lg:px-8">

        <div class="max-w-4xl">

          <p class="font-mono text-xs uppercase tracking-[0.3em] text-red-500">
            // COMMUNICATION_CHANNEL
          </p>

          <h1
            class="mt-5 font-mono text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl"
          >
            Get in touch.
          </h1>

          <p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-400">
            Open to professional opportunities, technical collaboration,
            cybersecurity discussions, and projects involving artificial
            intelligence and technology.
          </p>

          <div class="mt-8 flex flex-wrap gap-3 font-mono text-xs">

            <span
              class="border border-green-500/20 bg-green-500/5 px-3 py-2 text-green-400"
            >
              STATUS: AVAILABLE
            </span>

            <span
              class="border border-zinc-800 bg-zinc-950 px-3 py-2 text-zinc-500"
            >
              ACCESS: PUBLIC
            </span>

            <span
              class="border border-zinc-800 bg-zinc-950 px-3 py-2 text-zinc-500"
            >
              CHANNELS: 05
            </span>

          </div>

        </div>

      </div>
    </section>


    <!-- CONTACT CHANNELS -->
    <section class="border-b border-zinc-900 bg-[#080808] py-24">

      <div class="container mx-auto px-4">

        <div class="mb-12">

          <p class="cyber-label mb-3">// PRIMARY_CHANNELS</p>

          <h2 class="text-3xl font-bold text-white md:text-4xl">
            Professional contact
          </h2>

          <p class="mt-4 max-w-2xl leading-7 text-zinc-500">
            Use any of the following verified public channels to connect with
            Samuel Mallo.
          </p>

        </div>


        <div class="grid gap-6 md:grid-cols-2">

          <!-- EMAIL -->
          <a
            href="mailto:matthewmallo123@gmail.com"
            class="group relative overflow-hidden border border-zinc-800 bg-black p-7 transition-all duration-300 hover:-translate-y-1 hover:border-red-500/50 hover:shadow-[0_0_35px_rgba(220,38,38,0.08)]"
          >

            <div
              class="absolute left-0 top-0 h-px w-0 bg-red-500 transition-all duration-500 group-hover:w-full"
              aria-hidden="true"
            ></div>

            <div class="flex items-start justify-between gap-4">

              <div class="flex items-center gap-4">

                <div
                  class="flex h-12 w-12 items-center justify-center border border-zinc-800 bg-zinc-950 text-red-500 transition-colors group-hover:border-red-500/40"
                  aria-hidden="true"
                >
                  <!-- Email icon -->
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="m3 7 9 6 9-6"></path>
                  </svg>
                </div>

                <div>
                  <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-red-500">
                    CHANNEL_001
                  </span>

                  <h3 class="mt-1 text-xl font-bold text-white">
                    Email
                  </h3>
                </div>

              </div>

              <span class="font-mono text-xs text-green-500">
                ONLINE
              </span>

            </div>

            <p class="mt-6 break-all font-mono text-sm text-zinc-400">
              matthewmallo123@gmail.com
            </p>

            <div class="mt-6 border-t border-zinc-900 pt-4">
              <span class="font-mono text-xs text-red-500/70 transition-colors group-hover:text-red-400">
                [ SEND MESSAGE → ]
              </span>
            </div>

          </a>


          <!-- LINKEDIN -->
          <a
            href="https://www.linkedin.com/in/samuel-mallo-37aa322a4/"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden border border-zinc-800 bg-black p-7 transition-all duration-300 hover:-translate-y-1 hover:border-red-500/50 hover:shadow-[0_0_35px_rgba(220,38,38,0.08)]"
          >

            <div
              class="absolute left-0 top-0 h-px w-0 bg-red-500 transition-all duration-500 group-hover:w-full"
              aria-hidden="true"
            ></div>

            <div class="flex items-start justify-between gap-4">

              <div class="flex items-center gap-4">

                <div
                  class="flex h-12 w-12 items-center justify-center border border-zinc-800 bg-zinc-950 text-red-500 transition-colors group-hover:border-red-500/40"
                  aria-hidden="true"
                >
                  <!-- LinkedIn -->
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M6.5 8.5A1.75 1.75 0 1 0 6.5 5a1.75 1.75 0 0 0 0 3.5ZM5 10h3v9H5v-9Zm5 0h2.88v1.23h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.6V19h-3v-4.2c0-1-.02-2.3-1.4-2.3-1.4 0-1.62 1.1-1.62 2.23V19h-3v-9Z"></path>
                  </svg>
                </div>

                <div>
                  <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-red-500">
                    CHANNEL_002
                  </span>

                  <h3 class="mt-1 text-xl font-bold text-white">
                    LinkedIn
                  </h3>
                </div>

              </div>

              <span class="font-mono text-xs text-green-500">
                VERIFIED
              </span>

            </div>

            <p class="mt-6 text-sm text-zinc-400">
              Professional profile and career network
            </p>

            <div class="mt-6 border-t border-zinc-900 pt-4">
              <span class="font-mono text-xs text-red-500/70 transition-colors group-hover:text-red-400">
                [ OPEN PROFILE ↗ ]
              </span>
            </div>

          </a>


          <!-- GITHUB -->
          <a
            href="https://github.com/Matthew197501"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden border border-zinc-800 bg-black p-7 transition-all duration-300 hover:-translate-y-1 hover:border-red-500/50 hover:shadow-[0_0_35px_rgba(220,38,38,0.08)]"
          >

            <div
              class="absolute left-0 top-0 h-px w-0 bg-red-500 transition-all duration-500 group-hover:w-full"
              aria-hidden="true"
            ></div>

            <div class="flex items-start justify-between gap-4">

              <div class="flex items-center gap-4">

                <div
                  class="flex h-12 w-12 items-center justify-center border border-zinc-800 bg-zinc-950 text-red-500 transition-colors group-hover:border-red-500/40"
                  aria-hidden="true"
                >
                  <!-- GitHub -->
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.5-1.27-1.22-1.61-1.22-1.61-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.67 2.57 1.19 3.2.91.1-.71.38-1.19.7-1.46-2.51-.29-5.15-1.25-5.15-5.58 0-1.23.44-2.24 1.13-3.03-.11-.28-.49-1.44.11-2.99 0 0 .92-.3 3.11 1.16a10.8 10.8 0 0 1 5.66 0c2.19-1.46 3.1-1.16 3.1-1.16.6 1.55.22 2.71.11 2.99.7.79 1.13 1.8 1.13 3.03 0 4.34-2.64 5.29-5.16 5.57.39.34.74 1 .74 2.02v3c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .7Z"></path>
                  </svg>
                </div>

                <div>
                  <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-red-500">
                    CHANNEL_003
                  </span>

                  <h3 class="mt-1 text-xl font-bold text-white">
                    GitHub
                  </h3>
                </div>

              </div>

              <span class="font-mono text-xs text-green-500">
                PUBLIC
              </span>

            </div>

            <p class="mt-6 text-sm text-zinc-400">
              Projects, code, experiments, and technical work
            </p>

            <div class="mt-6 border-t border-zinc-900 pt-4">
              <span class="font-mono text-xs text-red-500/70 transition-colors group-hover:text-red-400">
                [ VIEW REPOSITORIES ↗ ]
              </span>
            </div>

          </a>


          <!-- CREDLY -->
          <a
            href="https://www.credly.com/users/samuel-mallo/"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden border border-zinc-800 bg-black p-7 transition-all duration-300 hover:-translate-y-1 hover:border-red-500/50 hover:shadow-[0_0_35px_rgba(220,38,38,0.08)]"
          >

            <div
              class="absolute left-0 top-0 h-px w-0 bg-red-500 transition-all duration-500 group-hover:w-full"
              aria-hidden="true"
            ></div>

            <div class="flex items-start justify-between gap-4">

              <div class="flex items-center gap-4">

                <div
                  class="flex h-12 w-12 items-center justify-center border border-zinc-800 bg-zinc-950 text-red-500 transition-colors group-hover:border-red-500/40"
                  aria-hidden="true"
                >
                  <!-- Credential badge -->
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                  >
                    <path d="M12 3 19 6v5c0 4.5-2.8 8-7 10-4.2-2-7-5.5-7-10V6l7-3Z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                  </svg>
                </div>

                <div>
                  <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-red-500">
                    CHANNEL_004
                  </span>

                  <h3 class="mt-1 text-xl font-bold text-white">
                    Credly
                  </h3>
                </div>

              </div>

              <span class="font-mono text-xs text-green-500">
                VERIFIED
              </span>

            </div>

            <p class="mt-6 text-sm text-zinc-400">
              Professional certifications and verified credentials
            </p>

            <div class="mt-6 border-t border-zinc-900 pt-4">
              <span class="font-mono text-xs text-red-500/70 transition-colors group-hover:text-red-400">
                [ VIEW CREDENTIALS ↗ ]
              </span>
            </div>

          </a>

        </div>

      </div>

    </section>


    <!-- SOCIAL -->
    <section class="border-b border-zinc-900 bg-black py-24">

      <div class="container mx-auto px-4">

        <div class="mx-auto max-w-3xl text-center">

          <p class="cyber-label mb-3">// PUBLIC_PRESENCE</p>

          <h2 class="text-3xl font-bold text-white md:text-4xl">
            Social &amp; public profile
          </h2>

          <p class="mx-auto mt-4 max-w-2xl leading-7 text-zinc-500">
            Additional public presence and professional-facing social
            channels.
          </p>

        </div>


        <div class="mx-auto mt-10 max-w-xl">

          <a
            href="https://www.facebook.com/Engr.Mallo"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between border border-zinc-800 bg-[#080808] p-6 transition-all duration-300 hover:border-red-500/50"
          >

            <div class="flex items-center gap-4">

              <div
                class="flex h-12 w-12 items-center justify-center border border-zinc-800 bg-zinc-950 text-red-500 transition-colors group-hover:border-red-500/40"
                aria-hidden="true"
              >
                <!-- Facebook -->
                <svg
                  class="h-6 w-6"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M13.5 21v-8h2.7l.4-3h-3.1V8.08c0-.87.24-1.46 1.5-1.46h1.7V3.94c-.3-.04-1.32-.14-2.5-.14-2.48 0-4.18 1.51-4.18 4.28V10H7.2v3h2.82v8h3.48Z"></path>
                </svg>
              </div>

              <div>

                <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-red-500">
                  CHANNEL_005
                </span>

                <h3 class="mt-1 text-lg font-bold text-white">
                  Facebook
                </h3>

                <p class="mt-1 text-sm text-zinc-500">
                  Engr. Mallo
                </p>

              </div>

            </div>

            <span class="font-mono text-xs text-red-500 transition-colors group-hover:text-red-400">
              OPEN ↗
            </span>

          </a>

        </div>

      </div>

    </section>


    <!-- TERMINAL -->
    <section class="bg-[#080808] py-20">

      <div class="container mx-auto px-4">

        <div class="mx-auto max-w-3xl border border-zinc-800 bg-black p-6 font-mono text-sm">

          <p class="text-zinc-600">
            samuel@mallo:~/contact$
          </p>

          <p class="mt-3 text-zinc-400">
            <span class="text-red-500">&gt;</span>
            Initializing communication channels...
          </p>

          <p class="mt-2 text-zinc-400">
            <span class="text-red-500">&gt;</span>
            05 public channels detected.
          </p>

          <p class="mt-2 text-zinc-400">
            <span class="text-red-500">&gt;</span>
            Professional contact interface online.
          </p>

          <p class="mt-2 text-green-400">
            <span class="text-green-500">&gt;</span>
            READY_FOR_CONNECTION_
          </p>

        </div>

      </div>

    </section>

  </main>
</BaseLayout>