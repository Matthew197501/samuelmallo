---
import { SITE } from "../../config";
---

<footer class="border-t border-slate-200 dark:border-slate-800">
  <div class="container mx-auto px-4 py-10 md:py-12">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="font-semibold text-slate-900 dark:text-white">{SITE.author.name}</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{SITE.description}</p>
      </div>

      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
      <p class="text-xs text-slate-500 dark:text-slate-400">
        &copy; {new Date().getFullYear()} {SITE.author.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
