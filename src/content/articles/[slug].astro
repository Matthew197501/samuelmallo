---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles
    .filter((article) => !article.data.draft)
    .map((article) => ({
      params: {
        slug: article.slug,
      },
      props: {
        article,
      },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout
  title={`${article.data.title} | Samuel Mallo`}
  description={article.data.description}
>
  <main class="bg-black py-16 md:py-24">
    <article class="mx-auto max-w-4xl px-4">

      <header class="mb-12">

        <a
          href="/articles"
          class="font-mono text-sm text-red-500 transition-colors hover:text-red-400"
        >
          ← Back to Articles
        </a>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span class="cyber-label">
            {article.data.category}
          </span>

          {article.data.featured && (
            <span class="rounded-md border border-red-500/30 bg-red-500/5 px-3 py-1 font-mono text-xs text-red-400">
              FEATURED
            </span>
          )}
        </div>

        <h1 class="mt-6 text-4xl font-bold tracking-tight text-white md:text-6xl">
          {article.data.title}
        </h1>

        <p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-400">
          {article.data.description}
        </p>

        <div class="mt-6 font-mono text-xs uppercase tracking-wider text-zinc-600">
          Published:
          {article.data.publishDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </div>

      </header>

      <div
        class="prose prose-invert prose-lg max-w-none
        prose-headings:text-white
        prose-p:text-zinc-400
        prose-p:leading-8
        prose-li:text-zinc-400
        prose-strong:text-white
        prose-code:text-red-400
        prose-blockquote:border-red-500
        prose-blockquote:text-zinc-400
        prose-a:text-red-500
        hover:prose-a:text-red-400"
      >
        <Content />
      </div>

      <footer class="mt-16 border-t border-zinc-900 pt-8">

        <a
          href="/articles"
          class="inline-flex items-center font-mono text-sm font-semibold text-red-500 transition-colors hover:text-red-400"
        >
          ← Return to knowledge base
        </a>

      </footer>

    </article>
  </main>
</BaseLayout>